<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BikeSync.Core</RootNamespace>
    <AssemblyName>BikeSync.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Wasmtime" Version="22.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\edge_core.wasm" LogicalName="BikeSync.Core.edge_core.wasm" />
  </ItemGroup>
</Project>
