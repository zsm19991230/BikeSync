<UserControl x:Class="BikeSync.App.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1080">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,12">
                <Grid Margin="0,4,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="平台连接" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="授权一次，之后自动记住登录状态。凭据只保存在这台电脑上。"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14"
                                           Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{Binding ConnectedCountText}"
                                       Margin="7,0,0,0"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,12,12"
                                    MinHeight="310"
                                    Padding="20"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="12"
                                                    Background="{Binding BrandColor, Converter={StaticResource HexToBrush}}">
                                                <TextBlock Text="{Binding Initial}"
                                                           Foreground="White"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                                             Fill="{Binding DotColor, Converter={StaticResource HexToBrush}}" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Tagline}"
                                               Style="{StaticResource MutedStyle}"
                                               Margin="0,15,0,0"
                                               LineHeight="19" />

                                    <Border Grid.Row="2"
                                            Background="#0BFFFFFF"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,15,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AccountName}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusDetail}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       LineHeight="16" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="3" Margin="0,13,0,0">
                                        <Border Background="#15FFB020"
                                                BorderBrush="#33FFB020"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="9,7"
                                                Visibility="{Binding ShowsConfigHint, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Warning24" FontSize="13"
                                                               Foreground="{StaticResource WarningBrush}" />
                                                <TextBlock Text="{Binding ConfigHint}"
                                                           Margin="6,0,0,0"
                                                           FontSize="10.5"
                                                           Foreground="#FFF7C86B"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                            <ui:Button Content="{Binding PrimaryActionText}"
                                                       Command="{Binding DataContext.OpenConnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       Style="{StaticResource PrimaryButtonStyle}"
                                                       FontSize="12"
                                                       Height="38"
                                                       MinHeight="38"
                                                       Padding="14,0" />
                                            <ui:Button Content="断开"
                                                       Command="{Binding DataContext.RequestDisconnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       Style="{StaticResource DangerGhostButtonStyle}"
                                                       Margin="6,0,0,0"
                                                       FontSize="11.5"
                                                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:Button Content="获取凭据"
                                                   Command="{Binding DataContext.OpenSetupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   Style="{StaticResource GhostButtonStyle}"
                                                   FontSize="10.5" />
                                        <ui:Button Content="接口说明"
                                                   Command="{Binding DataContext.OpenAccountsDocCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   Style="{StaticResource GhostButtonStyle}"
                                                   FontSize="10.5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="11"
                                Background="#1534D399" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="18"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,18,0">
                            <TextBlock Text="Windows DPAPI 本地保险箱"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="访问令牌、刷新令牌与 API Key 使用当前 Windows 用户的 DPAPI 加密后存入本机。应用不上传、不联网备份凭据，也不会把密码写入日志。"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="17" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="LOCAL ONLY"
                                   VerticalAlignment="Center"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Connect dialog overlay -->
        <Grid Background="#C4080D13"
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="540"
                    Style="{StaticResource CardStyle}"
                    Background="#FF141E2A"
                    BorderBrush="{StaticResource BorderBrushCustom}"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding DialogTitle}"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="21"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DialogDescription}"
                                       Style="{StaticResource MutedStyle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                   Command="{Binding CancelDialogCommand}"
                                   Appearance="Transparent"
                                   Width="32" Height="32"
                                   Padding="0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#12FF6B2C"
                            BorderBrush="#33FF6B2C"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Key24" FontSize="15"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Top" />
                            <TextBlock Text="{Binding DialogAuthHint}"
                                       Margin="9,0,0,0"
                                       FontSize="11.5"
                                       Foreground="#FFF0B99F"
                                       TextWrapping="Wrap"
                                       LineHeight="18" />
                        </StackPanel>
                    </Border>

                    <!-- Username/password form for MyWhoosh and iGPSPORT -->
                    <StackPanel Grid.Row="2"
                                Visibility="{Binding IsAccountPasswordFormVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding AccountIdentifierLabel}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,18,0,6" />
                        <ui:TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="账号"
                                    Height="40" />
                        <TextBlock Text="密码" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,14,0,6" />
                        <ui:PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{Binding AccountPasswordPlaceholder}"
                                        RevealButtonEnabled="True"
                                        Height="40" />
                        <TextBlock Text="密码只用于换取登录令牌，不会保存；本地仅加密保存访问令牌。"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Credential form -->
                    <StackPanel Grid.Row="2"
                                Visibility="{Binding IsApiCredentialFormVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="API Key" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,18,0,6" />
                        <ui:PasswordBox Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="粘贴平台 API Key"
                                        RevealButtonEnabled="True"
                                        Height="40" />

                        <StackPanel Visibility="{Binding IsRwgpsDialog, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Auth Token" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,14,0,6" />
                            <ui:PasswordBox Password="{Binding AuthToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="粘贴 Ride with GPS Auth Token"
                                            RevealButtonEnabled="True"
                                            Height="40" />
                        </StackPanel>

                        <TextBlock Text="凭据会使用 Windows DPAPI 加密后保存在本机，建议使用专用只读令牌。"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- OAuth form -->
                    <StackPanel Grid.Row="2"
                                Visibility="{Binding IsStravaDialog, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,18,0,0">
                        <Border Background="#0BFFFFFF" BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="13">
                            <StackPanel>
                                <TextBlock Text="浏览器授权流程"
                                           FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="点击下方按钮后会打开默认浏览器。完成 Strava 授权后，页面会自动关闭并把令牌交还给本应用。"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,5,0,0"
                                           LineHeight="17"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Background="#18F87171"
                            BorderBrush="#44F87171"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,14,0,0"
                            Visibility="{Binding DialogError, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding DialogError}"
                                   FontSize="11.5"
                                   Foreground="#FFFCA5A5"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="4" Margin="0,22,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="取消"
                                       Command="{Binding CancelDialogCommand}"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       IsEnabled="{Binding DialogCanBeClosed}" />
                            <ui:Button Content="{Binding DialogPrimaryText}"
                                       Command="{Binding ConnectCommand}"
                                       Style="{StaticResource PrimaryButtonStyle}"
                                       Margin="9,0,0,0">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowRight24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="20" Height="20"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Disconnect confirm -->
        <Grid Background="#C4080D13"
              Visibility="{Binding IsDisconnectOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="430"
                    Style="{StaticResource CardStyle}"
                    Background="#FF141E2A"
                    BorderBrush="{StaticResource BorderBrushCustom}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="#18F87171" HorizontalAlignment="Left">
                        <ui:SymbolIcon Symbol="SignOut24" FontSize="20"
                                       Foreground="{StaticResource DangerBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="断开这个平台？"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,15,0,0" />
                    <TextBlock Text="将删除本机保存的授权令牌，并取消持久登录。平台上的活动不会被删除，之后可以重新连接。"
                               Style="{StaticResource MutedStyle}"
                               Margin="0,7,0,0"
                               LineHeight="19" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <ui:Button Content="保留连接"
                                   Command="{Binding CancelDisconnectCommand}"
                                   Style="{StaticResource SecondaryButtonStyle}" />
                        <ui:Button Content="确认断开"
                                   Command="{Binding ConfirmDisconnectCommand}"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Margin="9,0,0,0"
                                   Background="{StaticResource DangerBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
