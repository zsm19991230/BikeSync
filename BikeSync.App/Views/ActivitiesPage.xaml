<UserControl x:Class="BikeSync.App.Views.ActivitiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1080">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,4,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="活动库" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="从已连接的平台拉取骑行记录，勾选后导入到另一个平台。"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,7,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Database24" FontSize="14"
                                   Foreground="{StaticResource InfoBrush}" />
                    <TextBlock Text="{Binding FilteredCountText}"
                               Margin="7,0,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="数据源" Style="{StaticResource EyebrowStyle}" Margin="1,0,0,5" />
                    <Grid>
                        <ComboBox ItemsSource="{Binding SourceOptions}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  Height="38"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding BrandColor, Converter={StaticResource HexToBrush}}" />
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="未连接平台"
                                   Margin="12,0,28,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="时间范围" Style="{StaticResource EyebrowStyle}" Margin="1,0,0,5" />
                    <ComboBox ItemsSource="{Binding DateRanges}"
                              SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Width="132"
                              Height="38" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,20,0,0"
                            Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVisibility}}">
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                Width="124" Height="38" />
                    <TextBlock Text="至" Margin="7,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                Width="124" Height="38" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0">
                    <ui:TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="搜索活动名称"
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                ClearButtonEnabled="True"
                                Width="178"
                                Height="38"
                                Margin="0,0,9,0" />
                    <CheckBox Content="仅骑行"
                              IsChecked="{Binding ShowCyclingOnly, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="2,0,12,0"
                              FontSize="11.5" />
                    <ui:Button Content="刷新活动"
                               Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                               Command="{Binding LoadActivitiesCommand}"
                               Style="{StaticResource PrimaryButtonStyle}"
                               Height="38"
                               MinHeight="38" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary / bulk select -->
        <Grid Grid.Row="2" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Border Width="1" Height="12" Background="{StaticResource BorderBrushCustom}"
                        Margin="11,0" />
                <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="已选 " />
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}" />
                    <Run Text=" 项 · " />
                    <Run Text="{Binding SelectedDistanceText, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding SelectedDurationText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="{Binding SelectAllText}"
                           Command="{Binding ToggleSelectAllCommand}"
                           Style="{StaticResource GhostButtonStyle}"
                           FontSize="11" />
                <ui:Button Content="清除选择"
                           Command="{Binding ClearSelectionCommand}"
                           Style="{StaticResource GhostButtonStyle}"
                           FontSize="11"
                           Margin="2,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8,4,8,8">
            <Grid>
                <ui:DataGrid ItemsSource="{Binding ActivitiesView}"
                             Style="{StaticResource ActivityGridStyle}"
                             MinHeight="220">
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="活动" Width="*" MinWidth="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="9"
                                                Background="{Binding PlatformColor, Converter={StaticResource HexToBrush}}"
                                                Opacity="0.16"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlatformShort}"
                                                       FontSize="8"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding PlatformColor, Converter={StaticResource HexToBrush}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding SportText}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="  ·  " FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding SourceText}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="180" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="时间" Width="132" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateText}" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="距离" Width="92" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DistanceText}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="移动时间" Width="96" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DurationText}" FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11.5" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="爬升" Width="88" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ElevationText}" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="均功率" Width="86" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PowerText}" FontSize="11.5"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>

                <!-- Empty state -->
                <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,20">
                    <Border Width="52" Height="52" CornerRadius="16"
                            Background="#12FFFFFF" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="VehicleBicycle24" FontSize="25"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding EmptyTitle}" Margin="0,14,0,0"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyHint}" Margin="0,6,0,0"
                               Style="{StaticResource CaptionStyle}"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <ui:Button Content="去平台连接"
                               Command="{Binding OpenAccountsCommand}"
                               Style="{StaticResource SecondaryButtonStyle}"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Loading overlay -->
                <Grid Background="#B30A0F16"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"
                                         Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="正在获取活动…" Margin="0,12,0,0"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="18,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCount, StringFormat=已选择 {0} 项活动}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="下一步：选择目标平台"
                               Icon="{ui:SymbolIcon Symbol=ArrowRight24}"
                               Command="{Binding OpenSyncCommand}"
                               IsEnabled="{Binding CanOpenSync}"
                               Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
