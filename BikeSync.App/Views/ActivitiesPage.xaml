<UserControl x:Class="BikeSync.App.Views.ActivitiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1080">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,4,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="活动库" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="从已连接的平台拉取骑行记录，勾选后导入到另一个平台。"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,7,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Database24" FontSize="14"
                                   Foreground="{StaticResource InfoBrush}" />
                    <TextBlock Text="{Binding FilteredCountText}"
                               Margin="7,0,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="数据源" Style="{StaticResource EyebrowStyle}" Margin="1,0,0,5" />
                    <Grid>
                        <ComboBox ItemsSource="{Binding SourceOptions}"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  Height="38"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding BrandColor, Converter={StaticResource HexToBrush}}" />
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="未连接平台"
                                   Margin="12,0,28,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="时间范围" Style="{StaticResource EyebrowStyle}" Margin="1,0,0,5" />
                    <ComboBox ItemsSource="{Binding DateRanges}"
                              SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Width="132"
                              Height="38" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,20,0,0"
                            Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVisibility}}">
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                Width="124" Height="38" />
                    <TextBlock Text="至" Margin="7,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                Width="124" Height="38" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0">
                    <ui:TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="搜索活动名称"
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                ClearButtonEnabled="True"
                                Width="178"
                                Height="38"
                                Margin="0,0,9,0" />
                    <CheckBox Content="仅骑行"
                              IsChecked="{Binding ShowCyclingOnly, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="2,0,12,0"
                              FontSize="11.5" />
                    <ui:Button Content="刷新活动"
                               Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                               Command="{Binding LoadActivitiesCommand}"
                               Style="{StaticResource PrimaryButtonStyle}"
                               Height="38"
                               MinHeight="38" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary / bulk select -->
        <Grid Grid.Row="2" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Border Width="1" Height="12" Background="{DynamicResource BorderBrushCustom}"
                        Margin="11,0" />
                <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="已选 " />
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}" />
                    <Run Text=" 项 · " />
                    <Run Text="{Binding SelectedDistanceText, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding SelectedDurationText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="{Binding SelectAllText}"
                           Command="{Binding ToggleSelectAllCommand}"
                           Style="{StaticResource GhostButtonStyle}"
                           FontSize="11" />
                <ui:Button Content="清除选择"
                           Command="{Binding ClearSelectionCommand}"
                           Style="{StaticResource GhostButtonStyle}"
                           FontSize="11"
                           Margin="2,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8,4,8,8">
            <Grid>
                <ui:DataGrid x:Name="ActivityGrid"
                             ItemsSource="{Binding ActivitiesView}"
                             Style="{StaticResource ActivityGridStyle}"
                             MouseDoubleClick="OnActivityDoubleClick"
                             MinHeight="220">
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="活动" Width="*" MinWidth="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10"
                                                Background="{Binding PlatformColor, Converter={StaticResource HexToBrush}}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlatformInitial}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding SportText}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="  ·  " FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding SourceText}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="180" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="时间" Width="132" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateText}" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="距离" Width="92" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DistanceText}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="移动时间" Width="96" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DurationText}" FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11.5" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="爬升" Width="88" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ElevationText}" FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="详情" Width="52" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Icon="{ui:SymbolIcon Symbol=ChevronRight24}"
                                               Width="30" Height="30"
                                               Padding="0"
                                               Appearance="Transparent"
                                               ToolTip="查看活动详情"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Command="{Binding DataContext.OpenDetailCommand,
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>

                <!-- Empty state -->
                <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,20">
                    <Border Width="52" Height="52" CornerRadius="16"
                            Background="#12FFFFFF" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="VehicleBicycle24" FontSize="25"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding EmptyTitle}" Margin="0,14,0,0"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyHint}" Margin="0,6,0,0"
                               Style="{StaticResource CaptionStyle}"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <ui:Button Content="去平台连接"
                               Command="{Binding OpenAccountsCommand}"
                               Style="{StaticResource SecondaryButtonStyle}"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Loading overlay -->
                <Grid Background="#B30A0F16"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"
                                         Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="正在获取活动…" Margin="0,12,0,0"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="18,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCount, StringFormat=已选择 {0} 项活动}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="下一步：选择目标平台"
                               Icon="{ui:SymbolIcon Symbol=ArrowRight24}"
                               Command="{Binding OpenSyncCommand}"
                               IsEnabled="{Binding CanOpenSync}"
                               Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Activity detail overlay -->
        <Grid Grid.RowSpan="5"
              Panel.ZIndex="20"
              Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#C8050A11" />
            <Border DataContext="{Binding Detail}"
                    Margin="4,6"
                    MaxWidth="1060"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="13"
                                Background="{Binding PlatformColor, Converter={StaticResource HexToBrush}}">
                            <TextBlock Text="{Binding PlatformInitial}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                   Width="34" Height="34"
                                   Padding="0"
                                   Appearance="Transparent"
                                   ToolTip="关闭详情"
                                   Command="{Binding DataContext.CloseDetailCommand,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid>

                    <!-- Error banner -->
                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Padding="12,8"
                            CornerRadius="10"
                            Background="#26F87171"
                            BorderBrush="#4DF87171"
                            BorderThickness="1"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24"
                                           FontSize="16"
                                           Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <!-- Map -->
                                <Border Style="{StaticResource CardStyle}"
                                        Padding="0"
                                        CornerRadius="16"
                                        ClipToBounds="True">
                                    <Grid Height="300" Background="#FF0B131C">
                                        <Viewbox Stretch="Uniform">
                                            <Canvas Width="640" Height="300" ClipToBounds="True">
                                                <Canvas.Background>
                                                    <DrawingBrush TileMode="Tile"
                                                                  Viewport="0,0,64,64"
                                                                  ViewportUnits="Absolute">
                                                        <DrawingBrush.Drawing>
                                                            <GeometryDrawing Geometry="M0,0 L0,64 M0,0 L64,0">
                                                                <GeometryDrawing.Pen>
                                                                    <Pen Brush="#0DFFFFFF" Thickness="1" />
                                                                </GeometryDrawing.Pen>
                                                            </GeometryDrawing>
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </Canvas.Background>
                                                <ItemsControl ItemsSource="{Binding MapTiles}"
                                                              Width="640"
                                                              Height="300">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding Image}"
                                                                   Width="256" Height="256" Stretch="Fill" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Width="640" Height="300"
                                                        Background="#330A0F16"
                                                        IsHitTestVisible="False" />
                                                <Polyline Points="{Binding RoutePoints}"
                                                          Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="4"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          IsHitTestVisible="False" />
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{StaticResource SuccessBrush}"
                                                         Stroke="#FF0A0F16"
                                                         StrokeThickness="2"
                                                         Canvas.Left="{Binding StartLeft}"
                                                         Canvas.Top="{Binding StartTop}" />
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{StaticResource DangerBrush}"
                                                         Stroke="#FF0A0F16"
                                                         StrokeThickness="2"
                                                         Canvas.Left="{Binding EndLeft}"
                                                         Canvas.Top="{Binding EndTop}" />
                                            </Canvas>
                                        </Viewbox>

                                        <TextBlock Text="{Binding TileHint}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Bottom"
                                                   Margin="12,0,0,9"
                                                   Visibility="{Binding TileHint, Converter={StaticResource StringToVisibility}}" />

                                        <TextBlock Text="{Binding MapAttribution}"
                                                   FontSize="9"
                                                   Foreground="#B3FFFFFF"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,10,7"
                                                   Visibility="{Binding HasMapTiles, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasRoute,
                                                                 Converter={StaticResource BoolToVisibility},
                                                                 ConverterParameter=Invert}">
                                            <ui:SymbolIcon Symbol="Map24"
                                                           FontSize="26"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding MapHint}"
                                                       Margin="0,8,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Track loading overlay: keep the metrics usable -->
                                        <Border Background="#CC0B131C"
                                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:ProgressRing IsIndeterminate="True"
                                                                 Width="36" Height="36"
                                                                 Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="正在读取活动轨迹…"
                                                           Margin="0,10,0,0"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Elevation profile -->
                                <Border Style="{StaticResource CardStyle}"
                                        Padding="18,14"
                                        Margin="0,14,0,0"
                                        Visibility="{Binding HasElevation, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="海拔剖面"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ElevationCaption}"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource CaptionStyle}" />
                                        </Grid>
                                        <Viewbox Stretch="Uniform" Height="86" Margin="0,8,0,0">
                                            <Canvas Width="640" Height="90">
                                                <Line X1="0" Y1="88" X2="640" Y2="88"
                                                      Stroke="{DynamicResource BorderBrushCustom}"
                                                      StrokeThickness="1" />
                                                <Polyline Points="{Binding ElevationPoints}"
                                                          Stroke="{StaticResource InfoBrush}"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <!-- Metrics -->
                                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="详细数据"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="4,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding Metrics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                                            BorderBrush="{DynamicResource BorderSoftBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="12,10"
                                                            Margin="0,0,8,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}"
                                                                       Style="{StaticResource EyebrowStyle}" />
                                                            <TextBlock Text="{Binding Value}"
                                                                       FontSize="17"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,5,0,0"
                                                                       Foreground="{Binding ValueBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Source file -->
                                <Border Style="{StaticResource FlatCardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="数据文件"
                                                   Style="{StaticResource EyebrowStyle}" />
                                        <TextBlock Text="{Binding SourceFileText}"
                                                   Margin="0,7,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <ui:Button Content="在平台查看原始活动"
                                                   Command="{Binding OpenOriginalCommand}"
                                                   Style="{StaticResource GhostButtonStyle}"
                                                   HorizontalAlignment="Left"
                                                   Margin="-8,8,0,0"
                                                   FontSize="11.5"
                                                   Visibility="{Binding WebUrl, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
