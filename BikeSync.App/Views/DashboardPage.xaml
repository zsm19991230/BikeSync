<UserControl x:Class="BikeSync.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1080">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,4,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding GreetingText}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="连接多个骑行平台，把每一次记录带到它该去的地方。"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource PillStyle}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding TodayText}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <ui:Button Content="开始同步"
                               Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                               Command="{Binding OpenActivitiesCommand}"
                               Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- Hero -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Background="{DynamicResource HeroGradientBrush}"
                    Padding="30"
                    MinHeight="212">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left"
                                Background="{DynamicResource AccentTintBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="9,4">
                            <TextBlock Text="跨平台骑行数据流转"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Text="你的骑行，不该被平台困住。"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="一次授权，长期记住登录状态。拉取 MyWhoosh、Strava、intervals.icu、Ride with GPS、iGPSPORT 与行者的骑行记录，勾选后导入 iGPSPORT、行者等目标平台。"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="21"
                                   MaxWidth="540"
                                   Margin="0,8,0,18" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="浏览我的活动"
                                       Icon="{ui:SymbolIcon Symbol=VehicleBicycle24}"
                                       Command="{Binding OpenActivitiesCommand}"
                                       Style="{StaticResource PrimaryButtonStyle}" />
                            <ui:Button Content="连接平台"
                                       Icon="{ui:SymbolIcon Symbol=PlugConnected24}"
                                       Command="{Binding OpenAccountsCommand}"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" IsHitTestVisible="False">
                        <Ellipse Width="190" Height="190"
                                 Stroke="{DynamicResource AccentBorderBrush}"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Margin="0,0,48,0" />
                        <Ellipse Width="132" Height="132"
                                 Stroke="{DynamicResource AccentBorderBrush}"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Margin="0,0,77,0" />
                        <Border Width="140" Height="140"
                                CornerRadius="70"
                                Background="{DynamicResource AccentTintBrush}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,73,0" />
                        <ui:SymbolIcon Symbol="VehicleBicycle24"
                                       FontSize="96"
                                       Foreground="#D9FFFFFF"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,87,0" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Metrics -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,16,0,0">
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PlugConnected24" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="已连接平台" Margin="8,0,0,0"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding PlatformCounterText}" Style="{StaticResource MetricStyle}" />
                            <TextBlock Text="个平台" Margin="8,0,0,5" VerticalAlignment="Bottom"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding AccountCount, StringFormat=共 {0} 个账户}"
                                   Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="6,0,6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CloudCheckmark24" FontSize="16"
                                           Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="累计成功导入" Margin="8,0,0,0"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding ImportedTotal}" Style="{StaticResource MetricStyle}" />
                            <TextBlock Text="项" Margin="8,0,0,5" VerticalAlignment="Bottom"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="最近同步记录统计" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="6,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="16"
                                           Foreground="{StaticResource InfoBrush}" />
                            <TextBlock Text="最近一次同步" Margin="8,0,0,0"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding LastSyncText}"
                                   Margin="0,13,0,0"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                        <TextBlock Text="所有数据仅在本机处理" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Platforms -->
            <Grid Grid.Row="3" Margin="0,26,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="平台连接" Style="{StaticResource SectionTitleStyle}" />
                    <ui:Button Content="管理全部"
                               Command="{Binding OpenAccountsCommand}"
                               Style="{StaticResource GhostButtonStyle}"
                               HorizontalAlignment="Right"
                               Margin="0,-6,0,0" />
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Platforms}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FlatCardStyle}" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="10"
                                                    Background="{Binding BrandColor, Converter={StaticResource HexToBrush}}"
                                                    Opacity="0.92">
                                                <TextBlock Text="{Binding Initial}"
                                                           Foreground="White"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Style="{StaticResource PillStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Padding="7,3">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                                         Fill="{Binding DotColor, Converter={StaticResource HexToBrush}}" />
                                                <TextBlock Text="{Binding AccountName}" FontSize="9.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           MaxWidth="94"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Tagline}"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="0,12,0,0"
                                               TextWrapping="Wrap"
                                               LineHeight="17" />
                                    <ui:Button Grid.Row="2"
                                               Content="{Binding ActionText}"
                                               Command="{Binding DataContext.OpenAccountsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Style="{StaticResource GhostButtonStyle}"
                                               HorizontalAlignment="Left"
                                               Margin="-8,8,0,-6"
                                               FontSize="11" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Recent sync -->
            <Grid Grid.Row="4" Margin="0,26,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="最近同步" Style="{StaticResource SectionTitleStyle}" />
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8,6" Margin="0,12,0,0">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding RecentSyncs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="14,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Route}" FontSize="12.5"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SummaryText}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TimestampText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,14,0" />
                                        <Border Grid.Column="2" Style="{StaticResource PillStyle}"
                                                Padding="8,3" Background="#1534D399">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SuccessBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    HorizontalAlignment="Center"
                                    Margin="0,28">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="28"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" />
                            <TextBlock Text="还没有同步记录" Margin="0,9,0,0"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="连接平台并完成第一次导入后，记录会显示在这里。"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
