<UserControl x:Class="BikeSync.App.Views.SyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1080">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,4,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="同步中心" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="选择一个或多个目标平台后开始导入。文件会先下载到本机，再分别上传到每个目标。"
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,7,0,0" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Content="返回活动库"
                       Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                       Command="{Binding BackToActivitiesCommand}"
                       Style="{StaticResource SecondaryButtonStyle}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <!-- Selection -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SourceTitle}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding SourceSubtitle}"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SelectionSummary}" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource DividerStyle}" Margin="0,15,0,8" />

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#08FFFFFF"
                                            BorderBrush="{StaticResource BorderSoftBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="4,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="{Binding State, Converter={StaticResource SyncStateSymbol}}"
                                                           FontSize="17"
                                                           Foreground="{Binding State, Converter={StaticResource SyncStateBrush}}"
                                                           VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="7,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding DateText}" FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="  ·  " FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding DistanceText}" FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="  ·  " FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding SourceName}" FontSize="10.5"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Visibility="{Binding Detail, Converter={StaticResource StringToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatusText}"
                                                       FontSize="10.5"
                                                       Foreground="{Binding State, Converter={StaticResource SyncStateBrush}}"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="120"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <Border Width="52" Height="52" CornerRadius="16"
                                    Background="#12FFFFFF"
                                    HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="VehicleBicycle24" FontSize="25"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="还没有待导入的活动"
                                       Margin="0,14,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="回到活动库勾选骑行记录，再继续选择目标平台。"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center" />
                            <ui:Button Content="去活动库选择"
                                       Command="{Binding BackToActivitiesCommand}"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Margin="0,13,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="#10FF6B2C"
                            BorderBrush="#22FF6B2C"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,9"
                            Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" FontSize="14"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Top" />
                            <TextBlock Text="MyWhoosh 的原始 FIT 会补正时间并尽量补充 NP/IF/TSS；Strava 源活动由数据流生成 TCX，其他平台优先使用原始文件。"
                                       Margin="8,0,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="16" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Target and run -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="导入目标" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="选择要接收这些骑行记录的平台账户。"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,5,0,0" />

                        <Grid Margin="0,19,0,6">
                            <TextBlock Text="目标账户（可多选）" Style="{StaticResource EyebrowStyle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="全选"
                                           Command="{Binding SelectAllTargetsCommand}"
                                           Style="{StaticResource GhostButtonStyle}"
                                           FontSize="10.5"
                                           Padding="8,2" />
                                <ui:Button Content="清空"
                                           Command="{Binding ClearTargetsCommand}"
                                           Style="{StaticResource GhostButtonStyle}"
                                           FontSize="10.5"
                                           Padding="8,2"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer MaxHeight="150"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding TargetOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,2,14,2"
                                                  IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBool}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding BrandColor, Converter={StaticResource HexToBrush}}" />
                                                <TextBlock Text="{Binding Label}" FontSize="11.5" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding SelectedTargetSummary}"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,7,0,0"
                                   Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibility}}" />

                        <Border Background="#12FFB020" BorderBrush="#33FFB020" BorderThickness="1"
                                CornerRadius="9" Padding="11,9" Margin="0,10,0,0"
                                Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="{Binding TargetHint}"
                                       FontSize="10.5"
                                       Foreground="#FFF7C86B"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{Binding TargetHint}"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibility}}" />

                        <CheckBox Content="同时保存一份原始活动文件到本地"
                                  IsChecked="{Binding SaveLocalCopy, Mode=TwoWay}"
                                  Margin="0,16,0,0"
                                  FontSize="11.5" />

                        <Border Style="{StaticResource DividerStyle}" Margin="0,17,0,14" />

                        <Grid>
                            <TextBlock Text="{Binding ProgressText}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                                       HorizontalAlignment="Right"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                        <ProgressBar Value="{Binding ProgressValue}"
                                     Maximum="100"
                                     Height="5"
                                     Margin="0,8,0,0"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="#1AFFFFFF"
                                     BorderThickness="0" />

                        <ui:Button Content="{Binding StartButtonText}"
                                   Icon="{ui:SymbolIcon Symbol=ArrowUpload24}"
                                   Command="{Binding StartCommand}"
                                   IsEnabled="{Binding CanStart}"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Height="44"
                                   Margin="0,17,0,0" />
                        <ui:Button Content="取消同步"
                                   Command="{Binding CancelCommand}"
                                   Style="{StaticResource GhostButtonStyle}"
                                   Margin="0,5,0,0"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Result -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="22" Margin="0,12,0,0"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="12"
                                        Background="#1534D399">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                                   FontSize="20"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ResultTitle}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ResultSummary}"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <UniformGrid Columns="3" Margin="0,18,0,0">
                                <Border Background="#1534D399" CornerRadius="9" Padding="10,9" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SuccessCount}" FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                        <TextBlock Text="成功上传" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#15FBBF24" CornerRadius="9" Padding="10,9" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DuplicateCount}" FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarningBrush}" />
                                        <TextBlock Text="重复跳过" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#15F87171" CornerRadius="9" Padding="10,9" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FailedCount}" FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource DangerBrush}" />
                                        <TextBlock Text="失败" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="#12F87171"
                                    BorderBrush="#33F87171"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="11,8"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding FirstError}"
                                           FontSize="10.5"
                                           Foreground="#FFFCA5A5"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ui:Button Content="打开本地导出文件夹"
                                       Command="{Binding OpenLocalFolderCommand}"
                                       Style="{StaticResource SecondaryButtonStyle}"
                                       Margin="0,14,0,0"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
