<ui:FluentWindow x:Class="BikeSync.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:BikeSync.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="骑迹同步 · BikeSync"
                 Width="1360" Height="880"
                 MinWidth="1120" MinHeight="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{StaticResource AppBackgroundBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="ClearType"
                 RenderOptions.ClearTypeHint="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title=" "
                     Background="{StaticResource AppBackgroundBrush}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     Height="44" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Height="150"
                            VerticalAlignment="Top"
                            Background="{StaticResource SidebarGlowBrush}"
                            IsHitTestVisible="False"
                            Opacity="0.75" />

                    <StackPanel Grid.Row="0" Margin="22,14,22,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12"
                                    Background="{StaticResource AccentGradientBrush}">
                                <ui:SymbolIcon Symbol="VehicleBicycle24"
                                               FontSize="25"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="骑迹同步"
                                           FontFamily="{StaticResource DisplayFontFamily}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="B I K E S Y N C"
                                           Margin="1,3,0,0"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Left" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13"
                                               Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="本地优先 · 令牌加密"
                                           Margin="6,0,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="12,10,12,0">
                        <TextBlock Text="工作台" Style="{StaticResource EyebrowStyle}" Margin="14,0,0,10" />
                        <ListBox ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                 Style="{StaticResource NavListStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0"
                                                       Symbol="{Binding Symbol}"
                                                       FontSize="18"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   Margin="6,0,0,0"
                                                   FontSize="13.5"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="18,10,18,18">
                        <Border Background="#FF0F1822"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource SuccessBrush}"
                                            Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="运行状态" FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SidebarAccountsText}"
                                           Margin="0,9,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SidebarSyncText}"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <ui:Button Content="管理平台账户"
                                           Command="{Binding GoToAccountsCommand}"
                                           Style="{StaticResource GhostButtonStyle}"
                                           HorizontalAlignment="Left"
                                           Margin="-8,8,0,0"
                                           FontSize="11.5" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="v1.0 · Windows Desktop"
                                   Margin="2,12,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1"
                  ClipToBounds="True"
                  Background="{StaticResource AppBackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Margin="36,20,36,24" />

                <!-- Toast -->
                <Border x:Name="Toast"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,30,26"
                        Width="380"
                        Background="#FA15202C"
                        BorderBrush="{StaticResource BorderBrushCustom}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.35" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9"
                                Background="#1AFFFFFF"
                                VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="{Binding ToastSymbol}"
                                           FontSize="16"
                                           Foreground="{Binding ToastColor, Converter={StaticResource HexToBrush}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                            <TextBlock Text="{Binding ToastTitle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding ToastColor, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="{Binding ToastMessage}"
                                       Margin="0,4,0,0"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       LineHeight="19" />
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                   Command="{Binding DismissToastCommand}"
                                   Appearance="Transparent"
                                   Width="28" Height="28"
                                   Padding="0"
                                   VerticalAlignment="Top"
                                   ToolTip="关闭" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
